# 由 ./setup.sh 產生 .env，不要手動複製這份。

# --- mock（離線示範）：隨機產生，只在本機 mock 之間使用 ---
MOCK_GRAPH_READER_ID=
MOCK_GRAPH_READER_SECRET=
MOCK_GRAPH_WRITER_ID=
MOCK_GRAPH_WRITER_SECRET=
MOCK_GITHUB_READ_TOKEN=
MOCK_GITHUB_ADMIN_TOKEN=
MOCK_PORT=8391

# --- 覆核 API ---
POSTGRES_PASSWORD=
JWT_SECRET=
AUTH_MODE=demo

# 選用：AI 規則提案。沒設定就停用 AI 功能，其他功能照常。接本機 Ollama 的範例：
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=qwen3.5:9b
# LLM_REASONING_EFFORT=none
# 改用 Claude：LLM_PROVIDER=anthropic、LLM_MODEL=claude-haiku-5-5、LLM_API_KEY=...

# --- live（真實 Entra 租戶，之後才用）：兩個 App 註冊，唯讀與寫入分開 ---
# ENTRA_TENANT_ID=
# ENTRA_READER_CLIENT_ID=
# ENTRA_READER_CLIENT_SECRET=
# ENTRA_WRITER_CLIENT_ID=
# ENTRA_WRITER_CLIENT_SECRET=
# GITHUB_ORG=
# GITHUB_READ_TOKEN=
# GITHUB_ADMIN_TOKEN=
